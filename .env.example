# Supabase: Project Settings > Database > Connection string (usa el "Session pooler" si tu red no tiene IPv6)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
# MongoDB: déjalo así para usar el contenedor, o pega la cadena de MongoDB Atlas en producción
MONGO_URI=mongodb://mongo:27017
VITE_API_URL=http://localhost:8080
